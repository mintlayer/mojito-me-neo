{
  "expo": {
    "name": "Mojito Wallet",
    "slug": "mojito-me",
    "version": "2.4.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "mojito-me",
    "backgroundColor": "#0b0a09",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0a09"
      }
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-build-properties",
      "./modules/mojito-core/app.plugin.js",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mojito uses Face ID to unlock your wallet and to guard the key that encrypts your recovery phrase."
        }
      ]
    ]
  }
}
