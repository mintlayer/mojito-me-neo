{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "nativewind",
    "types": ["node"],
    "paths": {
      "@mojito/core": ["./modules/mojito-core/index.ts"],
      "@config/*": ["./src/config/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@storage/*": ["./src/storage/*"],
      "@providers/*": ["./src/data/providers/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts"],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "tailwind.config.ts"
  ]
}
